# Нормализация переводов строк. Разработка на Windows, сборка iOS на macOS —
# без этого gradlew приезжает на раннер с CRLF и падает с "bad interpreter".

* text=auto eol=lf

# Скрипты, которые обязаны быть LF
gradlew         text eol=lf
*.sh            text eol=lf

# Windows-скрипты
gradlew.bat     text eol=crlf
*.bat           text eol=crlf

# Исходники и конфиги
*.java          text eol=lf
*.gradle        text eol=lf
*.xml           text eol=lf
*.properties    text eol=lf
*.yml           text eol=lf
*.md            text eol=lf

# Бинарники — не трогать
*.png           binary
*.jpg           binary
*.ogg           binary
*.mp3           binary
*.wav           binary
*.ttf           binary
*.otf           binary
*.fnt           binary
*.jar           binary
*.ipa           binary
